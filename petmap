<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pet Embassy - Bản Đồ Thú Cưng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-yellow-50 min-h-screen font-sans">

    <header class="bg-white border-b-4 border-yellow-400 p-4 sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center gap-2">
                <span class="text-3xl">🏛️</span>
                <h1 class="text-xl font-black text-yellow-700 uppercase tracking-tighter">Pet Embassy</h1>
            </div>
            <button onclick="openModal()" class="bg-yellow-400 hover:bg-yellow-500 text-yellow-900 px-5 py-2 rounded-xl font-bold shadow-sm transition-all active:scale-95">
                + Góp ý địa điểm
            </button>
        </div>
    </header>

    <section class="bg-yellow-400 p-8 text-center">
        <h2 class="text-2xl font-bold text-yellow-900">Tìm kiếm nơi dừng chân cho Boss! 🐾</h2>
        <p class="text-yellow-800 italic">Nơi chia sẻ những địa điểm thân thiện nhất với thú cưng.</p>
    </section>

    <main class="container mx-auto py-8 px-4">
        <div id="place-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            </div>
    </main>

    <div id="modal" class="fixed inset-0 bg-black/60 hidden flex items-center justify-center p-4 z-[100]">
        <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-2xl">
            <h2 class="text-xl font-bold mb-4 flex items-center gap-2">📍 Đánh dấu địa điểm mới</h2>
            <form id="pet-form" class="space-y-4">
                <input type="text" id="name" placeholder="Tên địa điểm (VD: Cafe Cún Con)" class="w-full border-2 border-gray-100 p-3 rounded-xl focus:border-yellow-400 outline-none" required>
                
                <select id="type" class="w-full border-2 border-gray-100 p-3 rounded-xl">
                    <option value="cafe">☕ Quán Cafe</option>
                    <option value="park">🌳 Công viên</option>
                    <option value="vet">🏥 Trạm thú y</option>
                </select>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Tiện ích cho thú cưng:</label>
                    <div class="grid grid-cols-2 gap-2 text-sm">
                        <label><input type="checkbox" value="Bát nước"> 💧 Bát nước</label>
                        <label><input type="checkbox" value="Rào chắn"> 🚪 Rào chắn</label>
                        <label><input type="checkbox" value="Đồ chơi"> 🧸 Đồ chơi</label>
                        <label><input type="checkbox" value="Thức ăn"> 🦴 Thức ăn</label>
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-6">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 text-gray-400 font-bold">Hủy</button>
                    <button type="submit" class="bg-yellow-400 text-yellow-900 px-6 py-2 rounded-xl font-bold">Chia sẻ ngay</button>
                </div>
            </form>
        </div>
    </div>

    <script src="app.js"></script>
</body>
</html>
